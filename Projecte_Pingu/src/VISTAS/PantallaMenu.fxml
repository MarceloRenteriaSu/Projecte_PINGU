<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane stylesheets="@PantallaMenu.css"
           xmlns="http://javafx.com/javafx/21.0.10"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="VISTAS.PantallaMenu"
           prefWidth="1024" prefHeight="576">

    <!-- Background landscape image -->
    <ImageView fx:id="bgImageView" mouseTransparent="true" preserveRatio="false"
               StackPane.alignment="CENTER">
        <image>
            <Image url="@menu_background.png" />
        </image>
    </ImageView>

    <!-- Main vertical layout -->
    <VBox alignment="CENTER" spacing="0" StackPane.alignment="CENTER"
          maxWidth="Infinity" maxHeight="Infinity">

        <!-- ======== TOP (green box): Title, no background ======== -->
        <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
            <ImageView fx:id="titleImageView" preserveRatio="true"
                       fitWidth="480" mouseTransparent="true">
                <image>
                    <Image url="@title_pinguino.png" />
                </image>
            </ImageView>
        </VBox>

        <!-- ======== BOTTOM (purple box): Wooden panel with 5 buttons ======== -->
        <VBox alignment="CENTER" spacing="0" styleClass="wooden-panel"
              maxWidth="Infinity">

            <HBox alignment="CENTER" styleClass="panel-snow-top" minHeight="16" maxHeight="16">
                <Label text="❄" styleClass="snow-deco" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="❄" styleClass="snow-deco" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="❄" styleClass="snow-deco" />
            </HBox>

            <HBox alignment="CENTER" spacing="16" styleClass="panel-inner"
                  maxWidth="Infinity">
                <padding>
                    <Insets top="14" bottom="14" left="24" right="24" />
                </padding>
                <Button fx:id="btnNewMatch" onAction="#handleNewMatch"
                        styleClass="menu-btn" text="NUEVA PARTIDA"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnLoadMatch" onAction="#handleLoadMatch"
                        styleClass="menu-btn" text="CARGAR PARTIDA"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnAjustes" onAction="#handleAjustes"
                        styleClass="menu-btn" text="AJUSTES"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnCredits" onAction="#handleCredits"
                        styleClass="menu-btn" text="CREDITOS"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnExit" onAction="#handleExit"
                        styleClass="menu-btn" text="SALIR"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>
    </VBox>

    <!-- Version label bottom-center -->
    <Label styleClass="version-label" text="V1.0.3"
           StackPane.alignment="BOTTOM_CENTER">
        <StackPane.margin>
            <Insets bottom="4" />
        </StackPane.margin>
    </Label>

    <!-- Username label top-right -->
    <Label fx:id="usernameLabel" styleClass="username-label" text="Jugador: "
           StackPane.alignment="TOP_RIGHT">
        <StackPane.margin>
            <Insets right="16" top="8" />
        </StackPane.margin>
    </Label>

</StackPane>
