<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane stylesheets="@PantallaMenu.css"
           xmlns="http://javafx.com/javafx/21.0.10"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="VISTAS.PantallaMenu"
           prefWidth="1024" prefHeight="576">

    <!-- Background landscape image -->
    <ImageView fx:id="bgImageView" mouseTransparent="true" preserveRatio="false"
               StackPane.alignment="CENTER">
        <image>
            <Image url="@menu_background.png" />
        </image>
    </ImageView>

    <!-- Main layout split: panel left + title right -->
    <HBox alignment="CENTER" spacing="20" StackPane.alignment="CENTER"
          maxHeight="Infinity" maxWidth="Infinity">
        <padding>
            <Insets bottom="30" left="40" right="40" top="20" />
        </padding>

        <!-- ======== LEFT: Wooden Panel with Buttons ======== -->
        <VBox alignment="CENTER" spacing="0" styleClass="wooden-panel"
              prefWidth="320" maxWidth="360" HBox.hgrow="NEVER">

            <!-- Snow/ice decoration on top of panel -->
            <HBox alignment="CENTER" styleClass="panel-snow-top" minHeight="18" maxHeight="18">
                <Label text="❄" styleClass="snow-deco" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="❄" styleClass="snow-deco" />
            </HBox>

            <!-- Inner area with buttons -->
            <VBox alignment="CENTER" spacing="12" styleClass="panel-inner">
                <padding>
                    <Insets bottom="25" left="30" right="30" top="20" />
                </padding>

                <Button fx:id="btnNewMatch" onAction="#handleNewMatch"
                        styleClass="menu-btn" text="NUEVA PARTIDA" maxWidth="Infinity" />
                <Button fx:id="btnLoadMatch" onAction="#handleLoadMatch"
                        styleClass="menu-btn" text="CARGAR PARTIDA" maxWidth="Infinity" />
                <Button fx:id="btnAjustes" onAction="#handleAjustes"
                        styleClass="menu-btn" text="AJUSTES" maxWidth="Infinity" />
                <Button fx:id="btnCredits" onAction="#handleCredits"
                        styleClass="menu-btn" text="CREDITOS" maxWidth="Infinity" />
                <Button fx:id="btnExit" onAction="#handleExit"
                        styleClass="menu-btn" text="SALIR" maxWidth="Infinity" />
            </VBox>
        </VBox>

        <!-- Spacer -->
        <Region HBox.hgrow="SOMETIMES" prefWidth="20" />

        <!-- ======== RIGHT: Game Title Image ======== -->
        <VBox alignment="CENTER" HBox.hgrow="ALWAYS" maxWidth="500">
            <ImageView fx:id="titleImageView" preserveRatio="true"
                       fitWidth="420" mouseTransparent="true">
                <image>
                    <Image url="@title_pinguino.png" />
                </image>
            </ImageView>
        </VBox>
    </HBox>

    <!-- Version label bottom-center -->
    <Label styleClass="version-label" text="V1.0.3"
           StackPane.alignment="BOTTOM_CENTER">
        <StackPane.margin>
            <Insets bottom="8" />
        </StackPane.margin>
    </Label>

    <!-- Username label top-right -->
    <Label fx:id="usernameLabel" styleClass="username-label" text="Jugador: "
           StackPane.alignment="TOP_RIGHT">
        <StackPane.margin>
            <Insets right="16" top="8" />
        </StackPane.margin>
    </Label>

</StackPane>
