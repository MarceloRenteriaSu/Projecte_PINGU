<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
    xmlns="http://javafx.com/javafx/21.0.10"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="VISTAS.PantallaMenu"
    stylesheets="@PantallaMenu.css"
    styleClass="root"
    prefWidth="1280"
    prefHeight="720">

    <!-- Background image fills entire window -->
    <ImageView fx:id="bgImageView" preserveRatio="false"
               fitWidth="1280" fitHeight="720"
               StackPane.alignment="CENTER" mouseTransparent="true">
        <image>
            <Image url="@menu_background.png"/>
        </image>
    </ImageView>

    <!-- Dark overlay for better readability on the left panel area -->
    <Region
        StackPane.alignment="TOP_LEFT"
        prefWidth="370" prefHeight="720"
        style="-fx-background-color: linear-gradient(to right, rgba(2,8,20,0.72), transparent);"
        mouseTransparent="true"/>

    <!-- Left-aligned menu content — mirrors the reference image layout -->
    <VBox alignment="TOP_LEFT" spacing="0" StackPane.alignment="TOP_LEFT"
          prefWidth="360">
        <padding>
            <Insets top="44" right="40" bottom="52" left="52"/>
        </padding>

        <!-- Game Title: two lines like the reference image -->
        <Label text="El juego" styleClass="game-title"/>
        <Label text="del pingu" styleClass="game-title" style="-fx-padding: -8 0 0 0;"/>

        <!-- Decorative ice separator -->
        <Label text="❄  ──────────────" styleClass="title-sep"/>

        <!-- Push buttons toward bottom-left, matching reference image -->
        <Region VBox.vgrow="ALWAYS"/>

        <!-- Menu Buttons — same order as the reference image -->
        <VBox spacing="12" styleClass="menu-buttons">
            <Button fx:id="btnNewMatch"   text="NUEVA PARTIDA"
                    onAction="#handleNewMatch"  styleClass="menu-btn"/>
            <Button fx:id="btnLoadMatch"  text="CARGAR PARTIDA"
                    onAction="#handleLoadMatch" styleClass="menu-btn"/>
            <Button fx:id="btnCredits"    text="CRÉDITOS"
                    onAction="#handleCredits"   styleClass="menu-btn"/>
            <Button fx:id="btnExit"       text="SALIR DEL JUEGO"
                    onAction="#handleExit"      styleClass="menu-btn"/>
        </VBox>

        <Region prefHeight="52"/>
    </VBox>
</StackPane>
