<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.effect.DropShadow?>

<StackPane stylesheets="@PantallaMenu.css"
           xmlns="http://javafx.com/javafx/21.0.10"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="VISTAS.PantallaMenu"
           prefWidth="1024" prefHeight="576">

    <!-- Fondo -->
    <ImageView fx:id="bgImageView" mouseTransparent="true" preserveRatio="false"
               StackPane.alignment="CENTER">
        <image>
            <Image url="@menu_background.png" />
        </image>
    </ImageView>

    <!-- Layout central: título + botones -->
    <VBox alignment="CENTER" spacing="28" StackPane.alignment="CENTER">

        <!-- Imagen del título (sin fondo) -->
        <ImageView fx:id="titleImageView" preserveRatio="true"
                   fitWidth="1000" mouseTransparent="true">
            <image>
                <Image url="@title_pinguino.png" />
            </image>
            <effect>
                <DropShadow color="rgba(0,0,0,0.65)" radius="18" spread="0.10" offsetX="0" offsetY="3" />
            </effect>
        </ImageView>

        <!-- Fila de botones individuales, cada uno con su propio marco -->
        <HBox alignment="CENTER" spacing="16" style="-fx-background-color: transparent;">
            <Button fx:id="btnNewMatch" onAction="#handleNewMatch"
                    styleClass="img-btn" prefWidth="130" prefHeight="92">
                <graphic>
                    <ImageView fitWidth="130" fitHeight="92" preserveRatio="true" mouseTransparent="true">
                        <image>
                            <Image url="@../pngs/boton_nuevaP.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <Button fx:id="btnLoadMatch" onAction="#handleLoadMatch"
                    styleClass="img-btn" prefWidth="130" prefHeight="92">
                <graphic>
                    <ImageView fitWidth="130" fitHeight="92" preserveRatio="true" mouseTransparent="true">
                        <image>
                            <Image url="@../pngs/boton_cargarP.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <Button fx:id="btnAjustes"   onAction="#handleAjustes"
                    styleClass="menu-btn" text="AJUSTES"
                    prefWidth="115" prefHeight="82" />
            <Button fx:id="btnCredits"   onAction="#handleCredits"
                    styleClass="menu-btn" text="CRÉDITOS"
                    prefWidth="115" prefHeight="82" />
            <Button fx:id="btnExit"      onAction="#handleExit"
                    styleClass="menu-btn" text="SALIR"
                    prefWidth="115" prefHeight="82" />
        </HBox>
    </VBox>

    <!-- Versión abajo al centro -->
    <Label styleClass="version-label" text="V1.0.3"
           StackPane.alignment="BOTTOM_CENTER">
        <StackPane.margin>
            <Insets bottom="8" />
        </StackPane.margin>
    </Label>

    <!-- Usuario arriba a la derecha -->
    <Label fx:id="usernameLabel" styleClass="username-label" text="Jugador: "
           StackPane.alignment="TOP_RIGHT">
        <StackPane.margin>
            <Insets right="16" top="8" />
        </StackPane.margin>
    </Label>

</StackPane>
