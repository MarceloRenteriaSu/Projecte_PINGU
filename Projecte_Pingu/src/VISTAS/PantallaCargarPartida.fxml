<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<VBox
    xmlns="http://javafx.com/javafx/21.0.10"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="VISTAS.PantallaCargarPartida"
    spacing="16"
    style="-fx-background-color: #1a1a2e; -fx-padding: 30;">

    <!-- Title -->
    <Label text="CARREGAR PARTIDA"
           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-family: 'Arial';" />

    <Label fx:id="lblUsername"
           text="Jugador: "
           style="-fx-font-size: 13px; -fx-text-fill: #aaaacc;" />

    <!-- Table of saved matches -->
    <TableView fx:id="tablePartides" VBox.vgrow="ALWAYS"
               style="-fx-background-color: #2a2a4e; -fx-control-inner-background: #2a2a4e; -fx-text-fill: white; -fx-border-color: #5555aa; -fx-border-width: 1;">
        <columns>
            <TableColumn fx:id="colNom"      text="Nom de la partida"  prefWidth="220" />
            <TableColumn fx:id="colJugadors" text="Jugadors"           prefWidth="220" />
            <TableColumn fx:id="colTorns"    text="Torns"              prefWidth="80"  />
            <TableColumn fx:id="colData"     text="Data guardada"      prefWidth="170" />
        </columns>
        <placeholder>
            <Label text="No tens cap partida guardada."
                   style="-fx-text-fill: #aaaacc; -fx-font-size: 14px;" />
        </placeholder>
    </TableView>

    <!-- Action buttons -->
    <HBox spacing="14">
        <Button fx:id="btnCarregar" text="CARREGAR" onAction="#handleCarregar"
                style="-fx-background-color: #4488ff; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 24; -fx-background-radius: 6; -fx-cursor: hand;" />
        <Button fx:id="btnEsborrar" text="ESBORRAR" onAction="#handleEsborrar"
                style="-fx-background-color: #cc3333; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 24; -fx-background-radius: 6; -fx-cursor: hand;" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnTornar"   text="TORNAR"   onAction="#handleTornar"
                style="-fx-background-color: #555566; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 24; -fx-background-radius: 6; -fx-cursor: hand;" />
    </HBox>
</VBox>
