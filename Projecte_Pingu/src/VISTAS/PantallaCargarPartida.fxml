<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox
    xmlns="http://javafx.com/javafx/21.0.10"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="VISTAS.PantallaCargarPartida"
    stylesheets="@PantallaMenu.css"
    styleClass="login-root"
    spacing="16"
    prefWidth="760"
    prefHeight="480">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <!-- Title -->
    <Label text="CARREGAR PARTIDA" styleClass="screen-title-label"/>

    <Label fx:id="lblUsername" text="Jugador: " styleClass="screen-sub-label"/>

    <!-- Table of saved matches -->
    <TableView fx:id="tablePartides" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colNom"      text="Nom de la partida"  prefWidth="220" />
            <TableColumn fx:id="colJugadors" text="Jugadors"           prefWidth="200" />
            <TableColumn fx:id="colTorns"    text="Torns"              prefWidth="80"  />
            <TableColumn fx:id="colData"     text="Data guardada"      prefWidth="180" />
        </columns>
        <placeholder>
            <Label text="No tens cap partida guardada." styleClass="screen-sub-label"/>
        </placeholder>
    </TableView>

    <!-- Action buttons -->
    <HBox spacing="14" alignment="CENTER_LEFT">
        <Button fx:id="btnCarregar" text="CARREGAR" onAction="#handleCarregar"
                styleClass="cp-primary-button"/>
        <Button fx:id="btnEsborrar" text="ESBORRAR" onAction="#handleEsborrar"
                styleClass="cp-secondary-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnTornar"   text="TORNAR"   onAction="#handleTornar"
                styleClass="cp-dock-button"/>
    </HBox>
</VBox>
