<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane
    xmlns="http://javafx.com/javafx/21.0.10"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="VISTAS.PantallaFin"
    stylesheets="@PantallaMenu.css"
    styleClass="root"
    prefWidth="520"
    prefHeight="380">

    <!-- Same background -->
    <ImageView preserveRatio="false" fitWidth="520" fitHeight="380"
               StackPane.alignment="CENTER" mouseTransparent="true">
        <image><Image url="@menu_background.png"/></image>
    </ImageView>

    <Region mouseTransparent="true"
            style="-fx-background-color: rgba(2,8,22,0.68);"/>

    <!-- Card -->
    <VBox spacing="16" alignment="CENTER" styleClass="card"
          maxWidth="440" StackPane.alignment="CENTER">
        <padding>
            <Insets top="32" right="28" bottom="32" left="28"/>
        </padding>

        <Text fx:id="icona"    styleClass="fin-titulo"    text="🏆"/>
        <Text fx:id="titulo"   styleClass="fin-titulo"    text="Fi de la Partida!"/>
        <Text fx:id="guanyador" styleClass="fin-subtitulo" text=""/>
        <Text fx:id="statsText" styleClass="fin-info"      text=""/>

        <Region prefHeight="8"/>

        <HBox spacing="14" alignment="CENTER">
            <Button fx:id="btnMenu"   text="🏠  Tornar al Menú"
                    styleClass="primary"   onAction="#handleVolverMenu" prefWidth="190"/>
            <Button fx:id="btnTancar" text="❌  Tancar"
                    styleClass="secondary" onAction="#handleTancar"     prefWidth="140"/>
        </HBox>
    </VBox>
</StackPane>
