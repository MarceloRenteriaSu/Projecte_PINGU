<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox
    xmlns="http://javafx.com/javafx/21.0.10"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="VISTAS.PantallaFin"
    stylesheets="@PantallaMenu.css"
    styleClass="login-root"
    alignment="CENTER"
    prefWidth="480"
    prefHeight="360">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <VBox styleClass="cp-login-card" spacing="16" alignment="CENTER">
        <padding>
            <Insets top="28" right="32" bottom="28" left="32"/>
        </padding>

        <!-- Icona i Títol -->
        <Text fx:id="icona" styleClass="card-big-text" text="🏆" />
        <Text fx:id="titulo" styleClass="card-big-text" text="¡Fin de la Partida!" />

        <Region prefHeight="4"/>

        <!-- Info del guanyador -->
        <Text fx:id="guanyador" styleClass="card-stat" text="" />

        <!-- Stats -->
        <Text fx:id="statsText" styleClass="card-info" text="" />

        <Region prefHeight="8"/>

        <!-- Botons -->
        <HBox spacing="16" alignment="CENTER">
            <Button fx:id="btnMenu" text="🏠 Volver al Menú"
                    styleClass="cp-primary-button"
                    onAction="#handleVolverMenu"
                    prefWidth="190"/>
            <Button fx:id="btnTancar" text="❌ Cerrar"
                    styleClass="cp-secondary-button"
                    onAction="#handleTancar"
                    prefWidth="190"/>
        </HBox>
    </VBox>
</VBox>
