<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
    xmlns="http://javafx.com/javafx/21.0.10"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="VISTAS.PantallaRegistro"
    stylesheets="@PantallaMenu.css"
    styleClass="root"
    prefWidth="1280"
    prefHeight="720">

    <ImageView preserveRatio="false" fitWidth="1280" fitHeight="720"
               StackPane.alignment="CENTER" mouseTransparent="true">
        <image><Image url="@menu_background.png"/></image>
    </ImageView>

    <Region mouseTransparent="true"
            style="-fx-background-color: rgba(2,8,22,0.62);"/>

    <VBox spacing="10" styleClass="card"
          maxWidth="420" StackPane.alignment="CENTER">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>

        <Label text="🐧  Registre de Nou Usuari" styleClass="title" wrapText="true"/>

        <Region prefHeight="4"/>

        <Label text="Nom d'usuari" styleClass="field-label"/>
        <TextField fx:id="usernameField" promptText="Introdueix el teu nom d'usuari" styleClass="field"/>

        <Region prefHeight="2"/>

        <Label text="Contrasenya" styleClass="field-label"/>
        <PasswordField fx:id="passwordField" promptText="Introdueix la contrasenya" styleClass="field"/>

        <Region prefHeight="2"/>

        <Label text="Confirmar contrasenya" styleClass="field-label"/>
        <PasswordField fx:id="confirmPasswordField" promptText="Repeteix la contrasenya" styleClass="field"/>

        <Region prefHeight="6"/>

        <Label fx:id="feedbackLabel" text="" styleClass="feedback" wrapText="true"/>

        <Button fx:id="btnRegistrar" text="✅  Registrar-se i Jugar"
                onAction="#handleRegistrar"
                maxWidth="Infinity"
                styleClass="primary"/>

        <Button fx:id="btnVolver" text="⬅  Tornar al Menú"
                onAction="#handleVolver"
                maxWidth="Infinity"
                styleClass="secondary"/>
    </VBox>
</StackPane>
