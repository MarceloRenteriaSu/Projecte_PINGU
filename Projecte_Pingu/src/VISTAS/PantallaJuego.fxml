<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>

<BorderPane
    xmlns="http://javafx.com/javafx/21.0.10"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="VISTAS.PantallaJuego"
    stylesheets="@PantallaJuego.css"
    styleClass="root">

    <top>
        <MenuBar>
            <menus>
                <Menu mnemonicParsing="false" text="File">
                    <items>
                        <MenuItem fx:id="newGame" mnemonicParsing="false" text="New" onAction="#handleNewGame"/>
                        <SeparatorMenuItem mnemonicParsing="false" />
                        <MenuItem fx:id="saveGame" mnemonicParsing="false" text="Save" onAction="#handleSaveGame"/>
                        <MenuItem fx:id="loadGame" mnemonicParsing="false" text="Load" onAction="#handleLoadGame"/>
                        <SeparatorMenuItem mnemonicParsing="false" />
                        <MenuItem fx:id="quitGame" mnemonicParsing="false" text="Quit" onAction="#handleQuitGame"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>

    <center>
        <HBox spacing="14" styleClass="snow-background">
            <padding>
                <Insets top="14" right="14" bottom="14" left="14"/>
            </padding>

            <!-- LEFT: Board fills all available space -->
            <StackPane HBox.hgrow="ALWAYS" styleClass="board-frame">

                <!-- Snowflake corner decorations -->
                <Label text="❄" mouseTransparent="true" styleClass="snow-corner"
                       StackPane.alignment="TOP_LEFT">
                    <StackPane.margin><Insets top="6" left="8"/></StackPane.margin>
                </Label>
                <Label text="❄" mouseTransparent="true" styleClass="snow-corner"
                       StackPane.alignment="TOP_RIGHT">
                    <StackPane.margin><Insets top="6" right="8"/></StackPane.margin>
                </Label>
                <Label text="❄" mouseTransparent="true" styleClass="snow-corner"
                       StackPane.alignment="BOTTOM_LEFT">
                    <StackPane.margin><Insets bottom="6" left="8"/></StackPane.margin>
                </Label>
                <Label text="❄" mouseTransparent="true" styleClass="snow-corner"
                       StackPane.alignment="BOTTOM_RIGHT">
                    <StackPane.margin><Insets bottom="6" right="8"/></StackPane.margin>
                </Label>

                <Canvas fx:id="pathCanvas" mouseTransparent="true" />
                <GridPane fx:id="tablero" styleClass="board"
                          maxWidth="Infinity" maxHeight="Infinity">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="20.0" />
                        <ColumnConstraints percentWidth="20.0" />
                        <ColumnConstraints percentWidth="20.0" />
                        <ColumnConstraints percentWidth="20.0" />
                        <ColumnConstraints percentWidth="20.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints percentHeight="10.0" />
                        <RowConstraints percentHeight="10.0" />
                        <RowConstraints percentHeight="10.0" />
                        <RowConstraints percentHeight="10.0" />
                        <RowConstraints percentHeight="10.0" />
                        <RowConstraints percentHeight="10.0" />
                        <RowConstraints percentHeight="10.0" />
                        <RowConstraints percentHeight="10.0" />
                        <RowConstraints percentHeight="10.0" />
                        <RowConstraints percentHeight="10.0" />
                    </rowConstraints>
                    <children>
                        <Circle fx:id="P1" id="P1" radius="8.0" styleClass="player" />
                        <Circle fx:id="P2" id="P2" radius="8.0" styleClass="player" />
                        <Circle fx:id="P3" id="P3" radius="8.0" styleClass="player" />
                        <Circle fx:id="P4" id="P4" radius="8.0" styleClass="player" />
                        <Circle fx:id="P5" id="P5" radius="8.0" styleClass="foca" />
                    </children>
                </GridPane>
            </StackPane>

            <!-- RIGHT: Sidebar with 3 stacked panels -->
            <VBox spacing="10" prefWidth="270" minWidth="220" maxWidth="320">

                <!-- DADO / Turn card -->
                <VBox spacing="8" styleClass="card">
                    <Label text="❄  Dado" styleClass="card-title" />
                    <Text fx:id="dadoResultText" text="Ha salido: -" styleClass="big-text" wrappingWidth="220" />
                    <Button fx:id="dado" text="Tirar dado" onAction="#handleDado"
                            maxWidth="Infinity" styleClass="primary" />
                </VBox>

                <!-- INVENTORY card -->
                <VBox spacing="8" styleClass="card">
                    <Label text="❄  Objetos" styleClass="card-title" />

                    <VBox spacing="8">
                        <padding>
                            <Insets top="2" right="2" bottom="2" left="2"/>
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Text fx:id="rapido_t" text="Dado Ràpid: x0" styleClass="stat" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="rapido" text="Usar" onAction="#handleRapido"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Text fx:id="lento_t" text="Dado Lent: x0" styleClass="stat" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="lento" text="Usar" onAction="#handleLento"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Text fx:id="peces_t" text="Peix: x0" styleClass="stat" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="peces" text="Usar" onAction="#handlePeces"/>
                        </HBox>

                    </VBox>
                </VBox>

                <!-- EVENTS card -->
                <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS">
                    <Label text="❄  Eventos" styleClass="card-title" />
                    <ListView fx:id="eventosListView" styleClass="events-list" VBox.vgrow="ALWAYS" />
                </VBox>

            </VBox>
        </HBox>
    </center>

</BorderPane>
