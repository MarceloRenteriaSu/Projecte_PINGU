<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
    xmlns="http://javafx.com/javafx/21.0.10"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="VISTAS.PantallaConfig"
    stylesheets="@PantallaMenu.css"
    styleClass="root"
    prefWidth="1280"
    prefHeight="720">

    <!-- Same pixel-art icy background -->
    <ImageView preserveRatio="false" fitWidth="1280" fitHeight="720"
               StackPane.alignment="CENTER" mouseTransparent="true">
        <image><Image url="@menu_background.png"/></image>
    </ImageView>

    <!-- Full dark overlay for readability -->
    <Region mouseTransparent="true"
            style="-fx-background-color: rgba(2,8,22,0.62);"/>

    <!-- Centered card -->
    <VBox spacing="10" styleClass="card"
          maxWidth="440" StackPane.alignment="CENTER">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>

        <Label text="⚙  Configuració de la Partida" styleClass="title" wrapText="true"/>

        <Region prefHeight="4"/>

        <Label text="Caselles del taulell (50 – 150)" styleClass="field-label"/>
        <TextField fx:id="casillasField" promptText="50" styleClass="field"/>

        <Region prefHeight="2"/>

        <Label text="Nombre de jugadors" styleClass="field-label"/>
        <ComboBox fx:id="jugadorsCombo" maxWidth="Infinity" styleClass="field"/>

        <Region prefHeight="2"/>

        <CheckBox fx:id="focaCheckBox" text="🦭  Activar la Foca (CPU)" selected="true"
                  style="-fx-font-family: 'Courier New'; -fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #9dd0ee;"/>

        <Region prefHeight="2"/>

        <Label text="Noms dels jugadors" styleClass="field-label"/>
        <VBox fx:id="nomsContainer" spacing="6"/>

        <Region prefHeight="6"/>

        <Label fx:id="feedbackLabel" text="" styleClass="feedback" wrapText="true"/>

        <Button fx:id="btnComenzar" text="🎮  Començar Partida"
                onAction="#handleComenzar"
                maxWidth="Infinity"
                styleClass="primary"/>
    </VBox>
</StackPane>
