<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox
    xmlns="http://javafx.com/javafx/21.0.10"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="VISTAS.PantallaConfig"
    stylesheets="@PantallaMenu.css"
    styleClass="login-root"
    spacing="14"
    alignment="CENTER"
    prefWidth="560"
    prefHeight="740">

    <padding>
        <Insets top="24" right="28" bottom="24" left="28"/>
    </padding>

    <VBox spacing="10" styleClass="cp-login-card" maxWidth="500">
        <padding>
            <Insets top="20" right="22" bottom="20" left="22"/>
        </padding>

        <Label text="⚙ Configuración de la Partida" styleClass="login-title" wrapText="true"/>

        <Region prefHeight="4"/>

        <!-- Caselles del taulell -->
        <Label text="Casillas del tablero (50 - 150)" styleClass="login-label"/>
        <TextField fx:id="casillasField" promptText="50" styleClass="login-field"/>

        <Region prefHeight="2"/>

        <!-- Número de jugadors -->
        <Label text="Número de jugadores" styleClass="login-label"/>
        <ComboBox fx:id="jugadorsCombo" maxWidth="Infinity" styleClass="cp-combo"/>

        <Region prefHeight="2"/>

        <!-- Activar/desactivar Foca -->
        <CheckBox fx:id="focaCheckBox" text="🦭 Activar la Foca (CPU)" selected="true"
                  styleClass="cp-checkbox"/>

        <Region prefHeight="2"/>

        <!-- Noms dels jugadors (dinàmic) -->
        <Label text="Nombres de los jugadores" styleClass="login-label"/>
        <VBox fx:id="nomsContainer" spacing="6"/>

        <Region prefHeight="6"/>

        <!-- Feedback -->
        <Label fx:id="feedbackLabel" text="" styleClass="login-feedback" wrapText="true"/>

        <!-- Botó comenzar -->
        <Button fx:id="btnComenzar" text="🎮 Empezar Partida"
                onAction="#handleComenzar"
                maxWidth="Infinity"
                styleClass="cp-primary-button"/>

        <Button fx:id="btnVolver" text="⬅ Volver al Menú"
                onAction="#handleVolver"
                maxWidth="Infinity"
                styleClass="cp-secondary-button"/>
    </VBox>
</VBox>
