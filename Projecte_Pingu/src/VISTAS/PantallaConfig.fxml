<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
    xmlns="http://javafx.com/javafx/21.0.10"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="VISTAS.PantallaConfig"
    stylesheets="@PantallaMenu.css"
    styleClass="config-root">

    <!-- Arctic background -->
    <ImageView fx:id="configBgView" mouseTransparent="true" preserveRatio="false">
        <image><Image url="@menu_background.png"/></image>
    </ImageView>

    <!-- Dark overlay for readability -->
    <Region mouseTransparent="true"
            style="-fx-background-color: rgba(0,8,25,0.58);"/>

    <!-- Snowflake decorations (corners) -->
    <Label text="❄" mouseTransparent="true" StackPane.alignment="TOP_LEFT"
           style="-fx-font-size:42px; -fx-text-fill: rgba(180,230,255,0.25);">
        <StackPane.margin><Insets top="10" left="14"/></StackPane.margin>
    </Label>
    <Label text="❄" mouseTransparent="true" StackPane.alignment="TOP_RIGHT"
           style="-fx-font-size:30px; -fx-text-fill: rgba(180,230,255,0.20);">
        <StackPane.margin><Insets top="50" right="30"/></StackPane.margin>
    </Label>
    <Label text="❄" mouseTransparent="true" StackPane.alignment="BOTTOM_RIGHT"
           style="-fx-font-size:50px; -fx-text-fill: rgba(180,230,255,0.18);">
        <StackPane.margin><Insets bottom="12" right="12"/></StackPane.margin>
    </Label>

    <!-- Central card -->
    <VBox alignment="TOP_CENTER" spacing="10" styleClass="config-card"
          maxWidth="460" StackPane.alignment="CENTER">
        <padding>
            <Insets top="26" right="34" bottom="26" left="34"/>
        </padding>

        <!-- Title -->
        <Label text="❄  CONFIGURACIÓ DE LA PARTIDA  ❄" styleClass="config-title" wrapText="true"/>

        <Region prefHeight="6"/>

        <!-- Caselles -->
        <Label text="Caselles del taulell  (50 – 150)" styleClass="config-label"/>
        <TextField fx:id="casillasField" promptText="50" styleClass="config-field"/>

        <Region prefHeight="2"/>

        <!-- Jugadors -->
        <Label text="Nombre de jugadors" styleClass="config-label"/>
        <ComboBox fx:id="jugadorsCombo" maxWidth="Infinity" styleClass="config-field"/>

        <Region prefHeight="2"/>

        <!-- Foca -->
        <CheckBox fx:id="focaCheckBox" text="🦭  Activar la Foca (CPU)" selected="true"
                  styleClass="config-check"/>

        <Region prefHeight="2"/>

        <!-- Noms dels jugadors -->
        <Label text="Noms dels jugadors" styleClass="config-label"/>
        <VBox fx:id="nomsContainer" spacing="7" styleClass="players-panel">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
        </VBox>

        <Region prefHeight="4"/>

        <!-- Feedback -->
        <Label fx:id="feedbackLabel" text="" styleClass="config-feedback" wrapText="true"/>

        <!-- Buttons -->
        <Button fx:id="btnComenzar" text="🎮  Començar Partida"
                onAction="#handleComenzar" maxWidth="Infinity"
                styleClass="config-primary"/>

        <Button fx:id="btnVolver" text="⬅  Tornar al Menú"
                onAction="#handleVolver" maxWidth="Infinity"
                styleClass="config-secondary"/>

    </VBox>

</StackPane>
