<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox
    xmlns="http://javafx.com/javafx/21.0.10"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="VISTAS.PantallaConfig"
    stylesheets="@PantallaMenu.css"
    styleClass="root"
    spacing="14"
    alignment="CENTER"
    prefWidth="480"
    prefHeight="580">

    <padding>
        <Insets top="24" right="28" bottom="24" left="28"/>
    </padding>

    <VBox spacing="8" styleClass="card" maxWidth="420">
        <padding>
            <Insets top="18" right="18" bottom="18" left="18"/>
        </padding>

        <Label text="⚙ Configuració de la Partida" styleClass="title" wrapText="true"/>

        <Region prefHeight="6"/>

        <!-- Caselles del taulell -->
        <Label text="Caselles del taulell (50 - 150)" styleClass="field-label"/>
        <TextField fx:id="casillasField" promptText="50" styleClass="field"/>

        <Region prefHeight="4"/>

        <!-- Número de jugadors -->
        <Label text="Nombre de jugadors" styleClass="field-label"/>
        <ComboBox fx:id="jugadorsCombo" maxWidth="Infinity" styleClass="field"/>

        <Region prefHeight="4"/>

        <!-- Activar/desactivar Foca -->
        <CheckBox fx:id="focaCheckBox" text="🦭 Activar la Foca (CPU)" selected="true"
                  style="-fx-font-weight: bold; -fx-font-size: 13px;"/>

        <Region prefHeight="4"/>

        <!-- Noms dels jugadors (dinàmic) -->
        <Label text="Noms dels jugadors" styleClass="field-label"/>
        <VBox fx:id="nomsContainer" spacing="6"/>

        <Region prefHeight="8"/>

        <!-- Feedback -->
        <Label fx:id="feedbackLabel" text="" styleClass="feedback" wrapText="true"/>

        <!-- Botó comenzar -->
        <Button fx:id="btnComenzar" text="🎮 Començar Partida"
                onAction="#handleComenzar"
                maxWidth="Infinity"
                styleClass="primary"/>

        <Button fx:id="btnVolver" text="⬅ Tornar al Menú"
                onAction="#handleVolver"
                maxWidth="Infinity"
                styleClass="secondary"/>
    </VBox>
</VBox>
