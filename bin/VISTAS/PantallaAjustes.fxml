<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox
    xmlns="http://javafx.com/javafx/21.0.10"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="VISTAS.PantallaAjustes"
    stylesheets="@PantallaMenu.css"
    styleClass="login-root"
    spacing="0"
    alignment="CENTER"
    prefWidth="460"
    prefHeight="300">

    <VBox spacing="14" styleClass="cp-login-card" maxWidth="400" alignment="CENTER">
        <padding>
            <Insets top="28" right="28" bottom="28" left="28"/>
        </padding>

        <Label text="⚙ Opciones" styleClass="login-title"/>

        <Region prefHeight="10"/>

        <!-- Volume slider -->
        <Label text="🎵 Volumen de la música" styleClass="login-label"/>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Slider fx:id="volumeSlider" min="0" max="100" value="50"
                    blockIncrement="5" showTickMarks="false" showTickLabels="false"
                    styleClass="settings-slider" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Label fx:id="volumeLabel" text="50%" styleClass="login-label" minWidth="42"/>
        </HBox>

        <Region prefHeight="4"/>

        <!-- Mute toggle -->
        <CheckBox fx:id="muteCheck" text="🔇 Silenciar música" styleClass="cp-checkbox"/>

        <Region prefHeight="16"/>

        <!-- Confirm button -->
        <Button text="✔ Cerrar" onAction="#handleCerrar"
                maxWidth="Infinity"
                styleClass="cp-dock-button"/>
    </VBox>
</VBox>
